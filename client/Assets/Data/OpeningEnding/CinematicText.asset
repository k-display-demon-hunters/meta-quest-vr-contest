  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4afadf883fc4b6d4ebf96029d2552d87, type: 3}
  m_Name: CinematicText
  m_EditorClassIdentifier: Assembly-CSharp::Cinematic.CinematicText
  Opening:
  - Start: 0.5
    End: 3.1
    Text: "기계는 세상을 어떻게 볼까요?"
    Voice: {fileID: 8300000, guid: 4b38b14883df49b0ae352e3391734f77, type: 3}
  - Start: 8.1
    End: 12.55
    Text: "최초의 CNN이 읽은 것은\n봉투에 손으로 쓴 우편번호입니다."
    Voice: {fileID: 8300000, guid: 9994ff6ad9f646969af05d3a915fdde5, type: 3}
  - Start: 17.05
    End: 20.78
    Text: "사람의 눈은 봉투에 적힌 우편번호를\n한눈에 읽습니다."
    Voice: {fileID: 8300000, guid: 79d8cdf088ce4a759352f3ab93461574, type: 3}
  - Start: 22.05
    End: 25.9
    Text: "그러나 기계가 보는 건\n밝고 어두운 점들입니다."
    Voice: {fileID: 8300000, guid: d4cd21470a064f8f91fce68305739db7, type: 3}
  - Start: 26.25
    End: 30.55
    Text: "기계는 이 점들 속에서 어떻게\n숫자를 알아낼 수 있을까요?"
    Voice: {fileID: 8300000, guid: 827be9a2740c48fea07eb409fc6fa5d1, type: 3}
  - Start: 31.05
    End: 34.65
    Text: "공장 안에서 그 답을 직접 찾아보세요."
    Voice: {fileID: 8300000, guid: 2ddb076224ab47a1b210e73db78a4f91, type: 3}
  Ending:
  - Start: 0.4
    End: 2.8
    Text: "1989\uB144,\n\uC22B\uC790 \uD558\uB098\uB97C \uC77D\uB358 \uB208\uC740"
    Voice: {fileID: 0}
  - Start: 15
    End: 16.6
    Text: "\uADF8\uB9AC\uACE0 \uC624\uB298,"
    Voice: {fileID: 0}
  - Start: 16.8
    End: 18
    Text: "{A:\uB2F9\uC2E0\uC774 \uB9CC\uB4E0 \uB208.}"
    Voice: {fileID: 0}
  - Start: 18.2
    End: 20
    Text: "\uADF8 \uC2DC\uC120\uC758 \uB05D\uC5D0,\n\uB2F9\uC2E0\uC758 CNN\uC774
      \uC788\uB2E4."
    Voice: {fileID: 0}

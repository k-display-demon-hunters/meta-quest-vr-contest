  m_Script: {fileID: 11500000, guid: 4afadf883fc4b6d4ebf96029d2552d87, type: 3}
  m_Name: CinematicText
  m_EditorClassIdentifier: Assembly-CSharp::Cinematic.CinematicText
  Opening:
  - Start: 0.5
    End: 3
    Text: "\uAE30\uACC4\uB294\n\uC138\uC0C1\uC744 \uBCFC \uC218 \uC788\uC744\uAE4C?"
    Voice: {fileID: 0}
  - Start: 7.6
    End: 11.8
    Text: "\uC580 \uB974\uCFE4\uC758 CNN\uC774\n\uC190\uAE00\uC528 \uC22B\uC790\uB97C
      \uC77D\uAE30 \uC2DC\uC791\uD588\uB2E4."
    Voice: {fileID: 0}
  - Start: 12.6
    End: 14.9
    Text: "\uC0AC\uB78C\uC5D0\uAC8C\uB294 '2'.\n\uAE30\uACC4\uC5D0\uAC8C\uB294 {C:\uC791\uC740
      \uC810 256\uAC1C}."
    Voice: {fileID: 0}
  - Start: 15.2
    End: 17.2
    Text: "\uAE30\uACC4\uB294 \uC5B4\uB5BB\uAC8C\n\uC774 \uC810\uB4E4\uC5D0\uC11C
      '2'\uB97C \uCC3E\uC544\uB0C8\uC744\uAE4C?"
    Voice: {fileID: 0}
  - Start: 17.2
    End: 18
    Text: "{C:CNN \uACF5\uC7A5}"
    Voice: {fileID: 0}
  - Start: 18
    End: 20
    Text: "\uADF8 \uB2F5\uC744, \uC9C1\uC811 \uB9CC\uB4E4\uC5B4 \uBCF4\uC138\uC694."
    Voice: {fileID: 0}
  Ending:
  - Start: 0.4
    End: 2.8
    Text: "1989\uB144,\n\uC22B\uC790 \uD558\uB098\uB97C \uC77D\uB358 \uB208\uC740"
    Voice: {fileID: 0}
  - Start: 15
    End: 16.6
    Text: "\uADF8\uB9AC\uACE0 \uC624\uB298,"
    Voice: {fileID: 0}
  - Start: 16.8
    End: 18
    Text: "{A:\uB2F9\uC2E0\uC774 \uB9CC\uB4E0 \uB208.}"
    Voice: {fileID: 0}
  - Start: 18.2
    End: 20
    Text: "\uADF8 \uC2DC\uC120\uC758 \uB05D\uC5D0,\n\uB2F9\uC2E0\uC758 CNN\uC774
      \uC788\uB2E4."
    Voice: {fileID: 0}
  PostOffice:
    Id: PO_1989_hall

    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "CNN\uC740 \uC791\uC740 \uC601\uC5ED\uC758 \uD2B9\uC9D5\uC744 \uCC3E\uACE0,
    \uC5EC\uB7EC \uCE35\uC744 \uAC70\uCCD0 \uACB0\uACFC\uB97C \uB9CC\uB4ED\uB2C8\uB2E4.\n\uC5EC\uC12F
    \uC7A5\uC758 \uAC1C\uB150 \uB450\uB8E8\uB9C8\uB9AC\uB85C \uCCB4\uD5D8\uC744 \uB3CC\uC544\uBCF4\uC138\uC694."

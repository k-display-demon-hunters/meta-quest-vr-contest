  m_Text: "\uC190\uC2E4\uC740 \uC608\uCE21\uACFC \uBAA9\uD45C\uC758 \uCC28\uC774\uB97C
    \uB098\uD0C0\uB0C5\uB2C8\uB2E4. \uC5ED\uC804\uD30C\uB85C \uAD6C\uD55C \uAE30\uC6B8\uAE30\uB85C
